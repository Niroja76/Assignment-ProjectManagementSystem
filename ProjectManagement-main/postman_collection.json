{
  "info": {
    "name": "Project Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Projects",
      "item": [
        {
          "name": "1. Create Project",
          "request": {
            "method": "POST",
            "url": "http://localhost:8080/api/projects",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"projectName\":\"Website Redesign\",\"description\":\"Redesign company website\",\"startDate\":\"2026-01-01\",\"endDate\":\"2026-12-31\",\"projectStatus\":\"ACTIVE\"}"
            }
          }
        },
        {
          "name": "2. Get Project by ID",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/projects/1"
          }
        },
        {
          "name": "3. Get All Projects",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/api/projects?page=0&size=10&sortBy=projectId"
          }
        },
        {
          "name": "4. Update Project",
          "request": {
            "method": "PUT",
            "url": "http://localhost:8080/api/projects/1",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\"projectName\":\"Website Redesign V2\",\"description\":\"Updated description\",\"startDate\":\"2026-01-01\",\"endDate\":\"2026-12-31\",\"projectStatus\":\"IN_PROGRESS\"}"
            }
          }
        },
        {
          "name": "5. Delete Project",
          "request": {
            "method": "DELETE",
            "url": "http://localhost:8080/api/projects/1"
          }
        }
      ]
    },
    {
