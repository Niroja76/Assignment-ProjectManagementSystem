              "raw": "{\"taskTitle\":\"Design Homepage\",\"description\":\"Wireframes completed\",\"priority\":\"HIGH\",\"status\":\"IN_PROGRESS\",\"dueDate\":\"2026-06-30\",\"projectId\":1,\"memberId\":1}"
